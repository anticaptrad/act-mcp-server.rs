PORT=8080
OTEL_SERVICE_NAME=act-mcp-server
# Environment-only secret. Use a random, whitespace-free value between 24 bytes and 4 KiB.
SERVER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_24_RANDOM_BYTES
# Exact comma-separated HTTP Host authorities accepted by /mcp.
MCP_ALLOWED_HOSTS=localhost,localhost:8080,127.0.0.1,127.0.0.1:8080,[::1],[::1]:8080,act-mcp-server,act-mcp-server:8080
# Comma-separated normalized browser origins. Leave empty for native clients only.
MCP_ALLOWED_ORIGINS=
